# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# third-party sound libraries (scripts/libraries/build.py): licences vary, some
# non-commercial or unstated, so they are published deliberately, never committed
.cache/
public/libraries/

# research docs: the papers and the figures extracted from them are
# copyrighted, and the rendered PDFs and audio are large and regenerable
docs/**/*.pdf
docs/**/*.mp3
docs/transitions.html
docs/lit-review/figures/

# other groups' peer-review submissions: theirs to share, and ~260 MB
docs/video peer review/

# python bytecode (scripts/)
__pycache__/
